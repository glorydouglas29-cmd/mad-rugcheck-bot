{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mad-rugcheck-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "kv_namespaces": [
    {
      "binding": "RUGCHECK_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
